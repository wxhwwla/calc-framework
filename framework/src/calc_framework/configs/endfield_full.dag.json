{
  "schema_version": "dag-v1",
  "name": "终末地伤害公式（完整版）",
  "description": "终末地 15 乘区完整伤害公式 DAG。6 块架构（ADR-0011）：属性块/攻击力块/暴击块/基础伤害块/增益减益块/环境乘区块。",
  "variables": {
    "character.基础攻击": {
      "type": "float",
      "source": "character",
      "description": "角色基础攻击力"
    },
    "weapon.基础攻击": {
      "type": "float",
      "source": "weapon",
      "description": "武器基础攻击力"
    },
    "weapon.攻击力+": {
      "type": "float",
      "source": "weapon",
      "description": "攻击力+ 小数加成（0.15 = 15%）"
    },
    "weapon.附加攻击力+": {
      "type": "float",
      "source": "weapon",
      "description": "附加攻击力+ 平值"
    },
    "equipment.攻击力平值": {
      "type": "float",
      "source": "equipment",
      "description": "装备平铺攻击力",
      "default": 0.0
    },
    "computed.主能力平值加算": {
      "type": "float",
      "source": "computed",
      "description": "主能力平值全部来源"
    },
    "computed.副能力平值加算": {
      "type": "float",
      "source": "computed",
      "description": "副能力平值全部来源"
    },
    "computed.主能力百分比": {
      "type": "float",
      "source": "computed",
      "description": "主能力百分比加成"
    },
    "computed.副能力百分比": {
      "type": "float",
      "source": "computed",
      "description": "副能力百分比加成"
    },
    "computed.技能倍率": {
      "type": "float",
      "source": "computed",
      "description": "技能倍率"
    },
    "computed.伤害加成": {
      "type": "float",
      "source": "computed",
      "description": "伤害加成区 = 1+类型+技能+失衡+其他"
    },
    "computed.伤害减免": {
      "type": "float",
      "source": "computed",
      "description": "伤害减免区 = ∏(1-减免值)"
    },
    "computed.增幅": {
      "type": "float",
      "source": "computed",
      "description": "增幅区 = 1+Σ增幅值"
    },
    "computed.虚弱": {
      "type": "float",
      "source": "computed",
      "description": "虚弱区 = ∏(1-虚弱值)"
    },
    "computed.庇护": {
      "type": "float",
      "source": "computed",
      "description": "庇护区 = 1-max(庇护值)"
    },
    "computed.脆弱": {
      "type": "float",
      "source": "computed",
      "description": "脆弱区 = 1+Σ脆弱值"
    },
    "computed.易伤": {
      "type": "float",
      "source": "computed",
      "description": "易伤区 = 1+Σ易伤值"
    },
    "computed.失衡易伤": {
      "type": "float",
      "source": "computed",
      "description": "失衡易伤区"
    },
    "computed.抗性": {
      "type": "float",
      "source": "computed",
      "description": "抗性区"
    },
    "computed.非主控减伤": {
      "type": "float",
      "source": "computed",
      "description": "非主控减伤区"
    },
    "computed.连击增伤": {
      "type": "float",
      "source": "computed",
      "description": "连击增伤区"
    },
    "computed.特殊乘区": {
      "type": "float",
      "source": "computed",
      "description": "特殊乘区"
    },
    "character.暴击率": {
      "type": "float",
      "source": "character",
      "description": "暴击率（小数，如 0.05 = 5%）",
      "default": 0.05
    },
    "character.暴击伤害": {
      "type": "float",
      "source": "character",
      "description": "暴击伤害（小数，如 0.5 = 50%）",
      "default": 0.5
    },
    "enemy.防御": {
      "type": "float",
      "source": "enemy",
      "description": "敌方防御值",
      "default": 100
    },
    "character.力量": {
      "type": "float",
      "source": "character",
      "description": "力量基础值",
      "default": 0.0
    },
    "character.敏捷": {
      "type": "float",
      "source": "character",
      "description": "敏捷基础值",
      "default": 0.0
    },
    "character.智识": {
      "type": "float",
      "source": "character",
      "description": "智识基础值",
      "default": 0.0
    },
    "character.意志": {
      "type": "float",
      "source": "character",
      "description": "意志基础值",
      "default": 0.0
    },
    "computed.力量加成值": {
      "type": "float",
      "source": "computed",
      "description": "力量加成值（武器技能）",
      "default": 0.0
    },
    "computed.敏捷加成值": {
      "type": "float",
      "source": "computed",
      "description": "敏捷加成值（武器技能）",
      "default": 0.0
    },
    "computed.智识加成值": {
      "type": "float",
      "source": "computed",
      "description": "智识加成值（武器技能）",
      "default": 0.0
    },
    "computed.意志加成值": {
      "type": "float",
      "source": "computed",
      "description": "意志加成值（武器技能）",
      "default": 0.0
    }
  },
  "subgraphs": {
    "ability_bonus": {
      "description": "能力值加成 15%+6% 公式",
      "parameters": {
        "main_flat": {
          "type": "float",
          "source": "computed",
          "description": "主能力平值"
        },
        "sub_flat": {
          "type": "float",
          "source": "computed",
          "description": "副能力平值"
        },
        "main_pct": {
          "type": "float",
          "source": "computed",
          "description": "主能力百分比"
        },
        "sub_pct": {
          "type": "float",
          "source": "computed",
          "description": "副能力百分比"
        }
      },
      "nodes": {
        "const_100": {
          "type": "const",
          "value": 100.0
        },
        "const_1": {
          "type": "const",
          "value": 1.0
        },
        "const_0005": {
          "type": "const",
          "value": 0.005
        },
        "const_0002": {
          "type": "const",
          "value": 0.002
        },
        "n_main_pct_div": {
          "type": "binary",
          "op": "/",
          "lhs": "main_pct",
          "rhs": "const_100"
        },
        "n_main_mul": {
          "type": "binary",
          "op": "+",
          "lhs": "const_1",
          "rhs": "n_main_pct_div"
        },
        "n_main": {
          "type": "binary",
          "op": "*",
          "lhs": "main_flat",
          "rhs": "n_main_mul",
          "label": "主能力*(1+主能力%/100)"
        },
        "n_sub_pct_div": {
          "type": "binary",
          "op": "/",
          "lhs": "sub_pct",
          "rhs": "const_100"
        },
        "n_sub_mul": {
          "type": "binary",
          "op": "+",
          "lhs": "const_1",
          "rhs": "n_sub_pct_div"
        },
        "n_sub": {
          "type": "binary",
          "op": "*",
          "lhs": "sub_flat",
          "rhs": "n_sub_mul",
          "label": "副能力*(1+副能力%/100)"
        },
        "n_main_x_0005": {
          "type": "binary",
          "op": "*",
          "lhs": "n_main",
          "rhs": "const_0005"
        },
        "n_sub_x_0002": {
          "type": "binary",
          "op": "*",
          "lhs": "n_sub",
          "rhs": "const_0002"
        },
        "result": {
          "type": "binary",
          "op": "+",
          "lhs": "n_main_x_0005",
          "rhs": "n_sub_x_0002",
          "label": "能力值加成 = main*0.005 + sub*0.002"
        }
      },
      "outputs": {
        "能力值加成": {
          "node": "result",
          "label": "能力值加成",
          "format": "",
          "is_primary": false
        }
      }
    },
    "final_attack": {
      "description": "最终攻击力 = 中间*(1+能力值加成)",
      "parameters": {
        "char_base_atk": {
          "type": "float",
          "source": "character",
          "description": "角色基础攻击力"
        },
        "weapon_base_atk": {
          "type": "float",
          "source": "weapon",
          "description": "武器基础攻击力"
        },
        "atk_bonus": {
          "type": "float",
          "source": "weapon",
          "description": "攻击力+ 小数加成"
        },
        "additional_atk": {
          "type": "float",
          "source": "weapon",
          "description": "附加攻击力+ 平值"
        },
        "equip_flat_atk": {
          "type": "float",
          "source": "equipment",
          "description": "装备平铺攻击力"
        },
        "ability_bonus": {
          "type": "float",
          "source": "computed",
          "description": "能力值加成"
        }
      },
      "nodes": {
        "const_1": {
          "type": "const",
          "value": 1.0
        },
        "n_base_atk": {
          "type": "binary",
          "op": "+",
          "lhs": "char_base_atk",
          "rhs": "weapon_base_atk",
          "label": "基础攻击力 = 角色+武器"
        },
        "n_add_one": {
          "type": "binary",
          "op": "+",
          "lhs": "const_1",
          "rhs": "atk_bonus"
        },
        "n_atk_bonus_part": {
          "type": "binary",
          "op": "*",
          "lhs": "n_add_one",
          "rhs": "n_base_atk",
          "label": "攻击加成攻击力 = 基础*(1+攻击力+)"
        },
        "n_add_atk_equip": {
          "type": "binary",
          "op": "+",
          "lhs": "additional_atk",
          "rhs": "equip_flat_atk"
        },
        "n_mid_atk": {
          "type": "binary",
          "op": "+",
          "lhs": "n_atk_bonus_part",
          "rhs": "n_add_atk_equip",
          "label": "中间攻击力 = 攻击加成攻击力+附加+装备"
        },
        "n_ability_one": {
          "type": "binary",
          "op": "+",
          "lhs": "const_1",
          "rhs": "ability_bonus"
        },
        "result": {
          "type": "binary",
          "op": "*",
          "lhs": "n_mid_atk",
          "rhs": "n_ability_one",
          "label": "最终攻击力 = 中间*(1+能力值加成)"
        }
      },
      "outputs": {
        "最终攻击力": {
          "node": "result",
          "label": "最终攻击力",
          "format": "",
          "is_primary": false
        }
      }
    },
    "single_hit_damage": {
      "description": "单段伤害 = 最终攻击力 * 技能倍率",
      "parameters": {
        "final_attack": {
          "type": "float",
          "source": "computed",
          "description": "最终攻击力"
        },
        "skill_mult": {
          "type": "float",
          "source": "computed",
          "description": "技能倍率"
        }
      },
      "nodes": {
        "result": {
          "type": "binary",
          "op": "*",
          "lhs": "final_attack",
          "rhs": "skill_mult",
          "label": "单段伤害 = 最终攻击力 * 技能倍率"
        }
      },
      "outputs": {
        "单段伤害": {
          "node": "result",
          "label": "单段伤害",
          "format": "",
          "is_primary": false
        }
      }
    },
    "crit_zone": {
      "description": "暴击区 = 1 + 暴击率*(暴击伤害-1)",
      "parameters": {
        "crit_rate": {
          "type": "float",
          "source": "character",
          "description": "暴击率"
        },
        "crit_damage": {
          "type": "float",
          "source": "character",
          "description": "暴击伤害"
        }
      },
      "nodes": {
        "const_1": {
          "type": "const",
          "value": 1.0
        },
        "n_crit_dmg_minus_one": {
          "type": "binary",
          "op": "-",
          "lhs": "crit_damage",
          "rhs": "const_1"
        },
        "n_crit_part": {
          "type": "binary",
          "op": "*",
          "lhs": "crit_rate",
          "rhs": "n_crit_dmg_minus_one"
        },
        "result": {
          "type": "binary",
          "op": "+",
          "lhs": "const_1",
          "rhs": "n_crit_part",
          "label": "暴击区 = 1 + 暴击率*(暴击伤害-1)"
        }
      },
      "outputs": {
        "暴击区": {
          "node": "result",
          "label": "暴击区",
          "format": "",
          "is_primary": false
        }
      }
    },
    "base_damage_block": {
      "description": "基础伤害块 = 最终攻击力 * 技能倍率 * 暴击区",
      "parameters": {
        "final_attack": {
          "type": "float",
          "source": "computed",
          "description": "最终攻击力"
        },
        "skill_mult": {
          "type": "float",
          "source": "computed",
          "description": "技能倍率"
        },
        "crit_zone": {
          "type": "float",
          "source": "computed",
          "description": "暴击区"
        }
      },
      "nodes": {
        "n_single_hit": {
          "type": "binary",
          "op": "*",
          "lhs": "final_attack",
          "rhs": "skill_mult",
          "label": "单段基础伤害"
        },
        "result": {
          "type": "binary",
          "op": "*",
          "lhs": "n_single_hit",
          "rhs": "crit_zone",
          "label": "暴击后伤害 = 单段基础 * 暴击区"
        }
      },
      "outputs": {
        "暴击后伤害": {
          "node": "result",
          "label": "暴击后伤害",
          "format": "",
          "is_primary": false
        }
      }
