    },
    {
      "id": "zone_detail",
      "type": "outputs",
      "title": "各区明细",
      "columns": 2,
      "outputs": ["攻击力结果", "增伤区", "防御区", "暴击区"]
    },
    {
      "id": "final_result",
      "type": "outputs",
      "title": "最终伤害",
      "columns": 1,
