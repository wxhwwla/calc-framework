      "type": "inputs",
      "title": "输入参数",
      "variables": [
        "user_input.base_atk",
        "user_input.atk_pct",
        "user_input.dmg_bonus",
        "user_input.defense_val",
        "user_input.crit_dmg_input",
        "user_input.is_crit"
