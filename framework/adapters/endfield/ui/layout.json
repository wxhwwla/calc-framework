{
  "schema_version": "ui-v1",
  "name": "终末地计算表",
  "description": "终末地 15 乘区公式的 ComputeSheet 排版 — 含敌人参数输入面板",
  "sections": [
    {
      "id": "enemy_defense",
      "type": "inputs",
      "title": "敌方防御",
      "columns": 2,
      "variables": [
        "user_input.敌人防御",
        "user_input.敌人等阶"
      ]
    },
    {
      "id": "enemy_resistance",
      "type": "inputs",
      "title": "敌方抗性",
      "columns": 2,
      "variables": [
        "user_input.敌人抗性",
        "user_input.无视抗性"
      ]
    },
    {
      "id": "enemy_imbalance",
      "type": "inputs",
      "title": "失衡",
      "columns": 2,
      "variables": [
        "user_input.失衡易伤系数",
        "user_input.是否失衡",
        "user_input.是否真实伤害",
        "user_input.连击层数"
      ]
    },
    {
      "id": "enemy_extra",
      "type": "inputs",
      "title": "额外加成",
      "columns": 2,
      "variables": [
        "user_input.额外暴击率",
        "user_input.额外暴击伤害",
        "user_input.额外伤害加成"
      ]
    },
    {
      "id": "extra_damage_gear",
      "type": "inputs",
      "title": "进阶参数",
      "columns": 2,
      "variables": [
        "user_input.附带效果倍率",
        "user_input.破防层数",
        "user_input.失衡效率加成",
        "user_input.腐蚀计时(秒)"
      ]
    },
    {
      "id": "character_attrs",
      "type": "outputs",
      "title": "角色属性",
      "columns": 2,
      "outputs": [
        "力量最终值",
        "敏捷最终值",
        "智识最终值",
        "意志最终值"
      ]
    },
    {
      "id": "attack_chain",
      "type": "outputs",
      "title": "攻击力链",
      "columns": 2,
      "outputs": [
        "能力值加成",
        "最终攻击力"
      ]
    },
    {
      "id": "base_and_crit",
      "type": "outputs",
      "title": "基础伤害区 & 暴击区",
      "columns": 2,
      "outputs": [
        "基础伤害区",
        "暴击区"
      ]
    },
    {
      "id": "dmg_bonus_group",
      "type": "outputs",
      "title": "伤害加成/减免/增幅",
      "columns": 2,
      "outputs": [
        "伤害加成区",
        "伤害减免区",
        "增幅区"
      ]
    },
    {
      "id": "debuff_zones",
      "type": "outputs",
      "title": "减益乘区",
      "columns": 2,
      "outputs": [
        "虚弱区",
        "庇护区",
        "脆弱区",
        "易伤区"
      ]
    },
    {
      "id": "defense_zones",
      "type": "outputs",
      "title": "防御/抗性/失衡",
      "columns": 2,
      "outputs": [
        "防御区",
        "失衡易伤区",
        "抗性区",
        "非主控减伤区"
      ]
    },
    {
      "id": "other_zones",
      "type": "outputs",
      "title": "其他乘区",
      "columns": 2,
      "outputs": [
        "连击增伤区",
        "特殊乘区"
      ]
    },
    {
      "id": "final_result",
      "type": "outputs",
      "title": "最终伤害",
      "columns": 1,
      "outputs": [
        "最终伤害"
      ]
    }
  ]
}
