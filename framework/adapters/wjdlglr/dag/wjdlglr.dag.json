      "path": "user_input.hit_rate_fluctuation",
      "label": "命中率随机浮动（%）"
    },
    "shots": {
      "type": "expr",
      "expr": "fleet_count * weapon_count * ammo_count * attack_runs",
      "inputs": {
        "fleet_count": "fleet_count",
        "weapon_count": "weapon_count",
        "ammo_count": "ammo_count",
        "attack_runs": "attack_runs"
      },
      "label": "发射数 = 编组数量 × 武器数量 × 弹药数 × 攻击次数"
    },
    "flight_time": {
      "type": "expr",
      "expr": "(outbound + inbound) * (1 - self_flight_bonus / 100 - (mothership_flight_bonus / 100 if needs_mothership > 0.5 else 0)) if needs_mothership > 0.5 and outbound + inbound > 0 else 0",
      "inputs": {
        "outbound": "outbound",
        "inbound": "inbound",
        "needs_mothership": "needs_mothership",
        "self_flight_bonus": "self_flight_bonus",
        "mothership_flight_bonus": "mothership_flight_bonus"
      },
      "label": "飞行时间 = (去程 + 回程) × (1 − 自身飞行加成 − 母舰飞行加成)"
    },
    "cooldown_duration": {
      "type": "expr",
      "expr": "base_cooldown * (1 - self_cooldown_bonus / 100 - (mothership_cooldown_bonus / 100 if needs_mothership > 0.5 else 0)) + base_duration * (1 - self_duration_bonus / 100 - (mothership_duration_bonus / 100 if needs_mothership > 0.5 else 0))",
      "inputs": {
        "base_cooldown": "base_cooldown",
        "base_duration": "base_duration",
        "needs_mothership": "needs_mothership",
        "self_cooldown_bonus": "self_cooldown_bonus",
        "mothership_cooldown_bonus": "mothership_cooldown_bonus",
        "self_duration_bonus": "self_duration_bonus",
        "mothership_duration_bonus": "mothership_duration_bonus"
      },
      "label": "冷却与持续时间 = 基础冷却 × (1 − 冷却加成) + 基础持续 × (1 − 持续加成)"
    },
    "rate_per_minute": {
      "type": "expr",
      "expr": "shots / max(cooldown_duration + flight_time, 0.001) * 60",
      "inputs": {
        "shots": "shots",
        "cooldown_duration": "cooldown_duration",
        "flight_time": "flight_time"
      },
      "label": "每分钟平均发射数 = 发射数 ÷ (冷却与持续时间 + 飞行时间) × 60"
    },
    "crit_core": {
      "type": "expr",
      "expr": "(crit_rate / 100 if crit_rate > 0 else (bonus_crit_rate / 100 if bonus_crit_rate > 0 else 0)) * (crit_damage / 100 if crit_damage > 0 else 0) * (1 + crit_multiplier_bonus / 100)",
      "inputs": {
        "crit_rate": "crit_rate",
        "crit_damage": "crit_damage",
        "bonus_crit_rate": "bonus_crit_rate",
        "crit_multiplier_bonus": "crit_multiplier_bonus"
      },
      "label": "暴击增伤倍率 = coalesce(武器暴击率, 加成暴击率) × 武器爆伤 × (1 + 暴击倍率加成)"
    },
    "crit_multiplier": {
      "type": "expr",
      "expr": "0 if crit_vs_air > 0.5 else crit_core",
      "inputs": {
        "crit_core": "crit_core",
        "crit_vs_air": "crit_vs_air"
      },
      "label": "对舰暴击增伤倍率（防空暴击对舰船不生效）"
    },
    "crit_multiplier_air": {
      "type": "expr",
      "expr": "crit_core",
      "inputs": {
        "crit_core": "crit_core"
      },
      "label": "对空暴击增伤倍率"
    },
    "armor_damage": {
      "type": "expr",
      "expr": "base_damage * (1 + damage_bonus / 100) - (energy_armor if is_energy > 0.5 else physical_armor)",
