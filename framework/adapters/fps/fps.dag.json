{
  "schema_version": "dag-v1",
  "name": "FPS 武器伤害计算",
  "description": "通用 FPS 武器伤害：基础 × 距离衰减 × 部位倍率 × 护甲减伤",
  "variables": {
    "weapon.base_damage": {"type": "float", "source": "weapon", "default": 30},
    "weapon.fire_rate": {"type": "float", "source": "weapon", "default": 600},
    "weapon.mag_size": {"type": "int", "source": "weapon", "default": 30},
    "weapon.reload_time": {"type": "float", "source": "weapon", "default": 2.5},
    "weapon.decay_start": {"type": "float", "source": "weapon", "default": 15},
    "weapon.decay_end": {"type": "float", "source": "weapon", "default": 50},
    "weapon.min_damage_ratio": {"type": "float", "source": "weapon", "default": 0.5},
    "weapon.penetration": {"type": "float", "source": "weapon", "default": 0},
    "enemy.distance": {"type": "float", "source": "enemy", "default": 20},
    "enemy.armor": {"type": "float", "source": "enemy", "default": 50},
    "enemy.head_mult": {"type": "float", "source": "enemy", "default": 2.0},
    "enemy.body_mult": {"type": "float", "source": "enemy", "default": 1.0},
    "user_input.is_head": {"type": "bool", "source": "user_input", "default": false},
    "user_input.is_limb": {"type": "bool", "source": "user_input", "default": false},
    "user_input.wall_pen_count": {"type": "int", "source": "user_input", "default": 0}
  },
  "nodes": {
    "const_1": {"type": "const", "value": 1.0},
    "const_0_75": {"type": "const", "value": 0.75},
    "const_100": {"type": "const", "value": 100.0},
    "const_60": {"type": "const", "value": 60.0},
    "const_0_5": {"type": "const", "value": 0.5},
    "var_distance": {"type": "var", "path": "enemy.distance"},
    "var_decay_start": {"type": "var", "path": "weapon.decay_start"},
    "var_decay_end": {"type": "var", "path": "weapon.decay_end"},
    "var_min_damage_ratio": {"type": "var", "path": "weapon.min_damage_ratio"},
    "var_head_mult": {"type": "var", "path": "enemy.head_mult"},
    "var_body_mult": {"type": "var", "path": "enemy.body_mult"},
    "var_is_head": {"type": "var", "path": "user_input.is_head"},
    "var_is_limb": {"type": "var", "path": "user_input.is_limb"},
    "var_base_damage": {"type": "var", "path": "weapon.base_damage"},
    "var_fire_rate": {"type": "var", "path": "weapon.fire_rate"},
    "var_mag_size": {"type": "var", "path": "weapon.mag_size"},
    "var_reload_time": {"type": "var", "path": "weapon.reload_time"},
    "var_enemy_armor": {"type": "var", "path": "enemy.armor"},
    "var_wall_pen_count": {"type": "var", "path": "user_input.wall_pen_count"},
    "location_mult": {"type": "condition", "cond": "var_is_head", "true_val": "var_head_mult", "false_val": "loc_body_or_limb", "label": "部位倍率"},
    "loc_body_or_limb": {"type": "condition", "cond": "var_is_limb", "true_val": "const_0_75", "false_val": "var_body_mult"},
    "base_vs_raw": {"type": "binary", "op": "*", "lhs": "var_base_damage", "rhs": "location_mult", "label": "基础×部位"},
    "le_start": {"type": "expr", "expr": "le(d, s)", "inputs": {"d": "var_distance", "s": "var_decay_start"}},
    "ge_end": {"type": "expr", "expr": "ge(d, e)", "inputs": {"d": "var_distance", "e": "var_decay_end"}},
    "decay_in_range": {"type": "condition", "cond": "le_start", "true_val": "const_1", "false_val": "decay_check_end", "label": "1 or check"},
    "decay_check_end": {"type": "condition", "cond": "ge_end", "true_val": "var_min_damage_ratio", "false_val": "decay_linear", "label": "min or linear"},
    "decay_linear": {"type": "expr", "expr": "1 - (1 - min_r) * (d - s) / (e - s)", "inputs": {"d": "var_distance", "s": "var_decay_start", "e": "var_decay_end", "min_r": "var_min_damage_ratio"}, "label": "线性衰减"},
    "after_decay": {"type": "binary", "op": "*", "lhs": "base_vs_raw", "rhs": "decay_in_range", "label": "衰减后伤害"},
    "armor_mult": {"type": "expr", "expr": "100 / (100 + a_val)", "inputs": {"a_val": "var_enemy_armor"}, "label": "护甲减伤比"},
    "after_armor": {"type": "binary", "op": "*", "lhs": "after_decay", "rhs": "armor_mult", "label": "护甲后伤害"},
    "pen_reduction": {"type": "binary", "op": "*", "lhs": "var_wall_pen_count", "rhs": "const_0_5"},
    "pen_mult": {"type": "expr", "expr": "max(0, 1 - pen_val)", "inputs": {"pen_val": "pen_reduction"}, "label": "穿透衰减"},
    "final_damage": {"type": "binary", "op": "*", "lhs": "after_armor", "rhs": "pen_mult", "label": "最终伤害"},
    "fire_rate_per_sec": {"type": "binary", "op": "/", "lhs": "var_fire_rate", "rhs": "const_60"},
    "dps_raw": {"type": "binary", "op": "*", "lhs": "var_base_damage", "rhs": "fire_rate_per_sec", "label": "原始 DPS(无衰减)"},
    "sustained_rate": {"type": "expr", "expr": "mag * (60 / rpm) / (mag * (60 / rpm) + reload)", "inputs": {"mag": "var_mag_size", "rpm": "var_fire_rate", "reload": "var_reload_time"}, "label": "持续开火占比"},
    "sustained_dps_final": {"type": "binary", "op": "*", "lhs": "dps_raw", "rhs": "sustained_rate", "label": "持续 DPS(含换弹)"},
    "sustained_dps_armor": {"type": "binary", "op": "*", "lhs": "sustained_dps_final", "rhs": "armor_mult", "label": "持续 DPS(含护甲)"}
  },
  "outputs": {
    "单发伤害": {"node": "final_damage", "label": "单发伤害", "is_primary": true},
    "距离衰减系数": {"node": "decay_in_range", "label": "距离衰减系数"},
    "部位倍率": {"node": "location_mult", "label": "部位倍率"},
    "护甲减伤比": {"node": "armor_mult", "label": "护甲减伤比"},
    "原始 DPS": {"node": "dps_raw", "label": "原始 DPS"},
    "持续 DPS(含换弹)": {"node": "sustained_dps_final", "label": "持续 DPS(含换弹)"},
    "持续 DPS(含护甲)": {"node": "sustained_dps_armor", "label": "持续 DPS(含护甲)"}
  }
}
