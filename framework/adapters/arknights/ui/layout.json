{
  "schema_version": "ui-v1",
  "name": "明日方舟伤害计算",
  "description": "明日方舟伤害计算 — ComputeSheet 声明式排版",
  "sections": [
    {
      "id": "skill_params",
      "type": "inputs",
      "title": "技能参数",
      "columns": 2,
      "variables": [
        "user_input.技能倍率",
        "user_input.技能等级",
        "user_input.攻击力百分比加成",
        "user_input.伤害加成"
      ]
    },
    {
      "id": "enemy",
      "type": "inputs",
      "title": "敌方参数",
      "columns": 2,
      "variables": [
        "user_input.敌人防御",
        "user_input.敌人法术抗性",
        "user_input.物理穿透",
        "user_input.法术穿透"
      ]
    },
    {
      "id": "extra_bonuses",
      "type": "inputs",
      "title": "额外增益",
      "columns": 2,
      "variables": [
        "user_input.信赖攻击",
        "user_input.潜能攻击"
      ]
    },
    {
      "id": "attack_output",
      "type": "outputs",
      "title": "攻击力",
      "columns": 1,
      "outputs": [
        "最终攻击力"
      ]
    },
    {
      "id": "damage_output",
      "type": "outputs",
      "title": "伤害结果",
      "columns": 3,
      "outputs": [
        "物理伤害",
        "法术伤害",
        "真伤伤害"
      ]
    }
  ]
}
