{
  "schema_version": "dag-v1",
  "name": "MOBA 英雄伤害计算",
  "description": "通用 MOBA 伤害公式 DAG。技能伤害 = (基础+加成) × 暴击 × 减伤",
  "variables": {
    "character.attack_damage": {"type": "float", "source": "character", "default": 60},
    "character.ability_power": {"type": "float", "source": "character", "default": 0},
    "character.armor": {"type": "float", "source": "character", "default": 30},
    "character.magic_resist": {"type": "float", "source": "character", "default": 30},
    "character.cooldown_reduction": {"type": "float", "source": "character", "default": 0},
    "character.attack_speed_bonus": {"type": "float", "source": "character", "default": 0},
    "character.crit_rate": {"type": "float", "source": "character", "default": 0},
    "character.crit_dmg": {"type": "float", "source": "character", "default": 1.75},
    "character.lethality": {"type": "float", "source": "character", "default": 0},
    "character.armor_pen_pct": {"type": "float", "source": "character", "default": 0},
    "character.magic_pen": {"type": "float", "source": "character", "default": 0},
    "character.magic_pen_pct": {"type": "float", "source": "character", "default": 0},
    "enemy.armor": {"type": "float", "source": "enemy", "default": 50},
    "enemy.magic_resist": {"type": "float", "source": "enemy", "default": 30},
    "user_input.skill_base_damage": {"type": "float", "source": "user_input", "default": 100},
    "user_input.ad_ratio": {"type": "float", "source": "user_input", "default": 0},
    "user_input.ap_ratio": {"type": "float", "source": "user_input", "default": 0},
    "user_input.is_physical": {"type": "bool", "source": "user_input", "default": true},
    "user_input.is_crit": {"type": "bool", "source": "user_input", "default": false},
    "user_input.skill_cooldown": {"type": "float", "source": "user_input", "default": 10}
  },
  "nodes": {
    "const_1": {"type": "const", "value": 1.0},
    "const_0": {"type": "const", "value": 0.0},
    "var_ad_ratio": {"type": "var", "path": "user_input.ad_ratio"},
    "var_attack_damage": {"type": "var", "path": "character.attack_damage"},
    "var_ap_ratio": {"type": "var", "path": "user_input.ap_ratio"},
    "var_ability_power": {"type": "var", "path": "character.ability_power"},
    "var_skill_base": {"type": "var", "path": "user_input.skill_base_damage"},
    "var_crit_dmg": {"type": "var", "path": "character.crit_dmg"},
    "var_is_crit": {"type": "var", "path": "user_input.is_crit"},
    "var_is_physical": {"type": "var", "path": "user_input.is_physical"},
    "var_enemy_armor": {"type": "var", "path": "enemy.armor"},
    "var_lethality": {"type": "var", "path": "character.lethality"},
    "var_armor_pen_pct": {"type": "var", "path": "character.armor_pen_pct"},
    "var_enemy_mr": {"type": "var", "path": "enemy.magic_resist"},
    "var_magic_pen": {"type": "var", "path": "character.magic_pen"},
    "var_magic_pen_pct": {"type": "var", "path": "character.magic_pen_pct"},
    "var_cooldown_reduction": {"type": "var", "path": "character.cooldown_reduction"},
    "var_skill_cooldown": {"type": "var", "path": "user_input.skill_cooldown"},
    "var_attack_speed_bonus": {"type": "var", "path": "character.attack_speed_bonus"},
    "base_atk_mult": {"type": "binary", "op": "*", "lhs": "var_ad_ratio", "rhs": "var_attack_damage", "label": "AD 加成值"},
    "base_ap_mult": {"type": "binary", "op": "*", "lhs": "var_ap_ratio", "rhs": "var_ability_power", "label": "AP 加成值"},
    "skill_raw": {"type": "binary", "op": "+", "lhs": "var_skill_base", "rhs": "base_atk_mult", "label": "技能基础+AD"},
    "skill_total_raw": {"type": "binary", "op": "+", "lhs": "skill_raw", "rhs": "base_ap_mult", "label": "技能总基础伤害"},
    "crit_mult": {"type": "binary", "op": "+", "lhs": "const_1", "rhs": "var_crit_dmg", "label": "暴击倍率"},
    "crit_choice": {"type": "condition", "cond": "var_is_crit", "true_val": "crit_mult", "false_val": "const_1", "label": "暴击判定"},
    "after_crit": {"type": "binary", "op": "*", "lhs": "skill_total_raw", "rhs": "crit_choice", "label": "暴击后伤害"},
    "effective_armor_raw": {"type": "binary", "op": "-", "lhs": "var_enemy_armor", "rhs": "var_lethality", "label": "护甲-穿甲"},
    "armor_pen_factor": {"type": "binary", "op": "-", "lhs": "const_1", "rhs": "var_armor_pen_pct"},
    "armor_after_pct": {"type": "binary", "op": "*", "lhs": "effective_armor_raw", "rhs": "armor_pen_factor", "label": "穿甲后护甲"},
    "effective_armor_final": {"type": "expr", "expr": "max(0, armor_val)", "inputs": {"armor_val": "armor_after_pct"}, "label": "最终有效护甲"},
    "phys_mult": {"type": "expr", "expr": "armor_mult(armor_val, 0, 0)", "inputs": {"armor_val": "effective_armor_final"}, "label": "物理减伤比"},
    "effective_mr_raw": {"type": "binary", "op": "-", "lhs": "var_enemy_mr", "rhs": "var_magic_pen", "label": "魔抗-法穿"},
    "mr_pen_factor": {"type": "binary", "op": "-", "lhs": "const_1", "rhs": "var_magic_pen_pct"},
    "mr_after_pct": {"type": "binary", "op": "*", "lhs": "effective_mr_raw", "rhs": "mr_pen_factor", "label": "穿透后魔抗"},
    "effective_mr_final": {"type": "expr", "expr": "max(0, mr_val)", "inputs": {"mr_val": "mr_after_pct"}, "label": "最终有效魔抗"},
    "magic_mult": {"type": "expr", "expr": "100 / (100 + mr_val)", "inputs": {"mr_val": "effective_mr_final"}, "label": "魔法减伤比"},
    "damage_mult": {"type": "condition", "cond": "var_is_physical", "true_val": "phys_mult", "false_val": "magic_mult", "label": "选择减伤"},
    "final_damage": {"type": "binary", "op": "*", "lhs": "after_crit", "rhs": "damage_mult", "label": "最终伤害"},
    "cdr_factor": {"type": "binary", "op": "-", "lhs": "const_1", "rhs": "var_cooldown_reduction"},
    "actual_cooldown": {"type": "binary", "op": "*", "lhs": "var_skill_cooldown", "rhs": "cdr_factor", "label": "实际冷却"},
    "attack_speed_mult": {"type": "binary", "op": "+", "lhs": "const_1", "rhs": "var_attack_speed_bonus"},
    "attack_interval": {"type": "expr", "expr": "60 / (60 * speed_mult)", "inputs": {"speed_mult": "attack_speed_mult"}, "label": "攻击间隔(秒)"}
  },
  "outputs": {
    "技能总伤害": {"node": "final_damage", "label": "技能总伤害", "is_primary": true},
    "基础伤害": {"node": "skill_total_raw", "label": "基础伤害(暴击前)"},
    "暴击后伤害": {"node": "after_crit", "label": "暴击后伤害"},
    "物理减伤比": {"node": "phys_mult", "label": "物理减伤比"},
    "魔法减伤比": {"node": "magic_mult", "label": "魔法减伤比"},
    "实际冷却(秒)": {"node": "actual_cooldown", "label": "实际冷却(秒)"},
    "攻击间隔(秒)": {"node": "attack_interval", "label": "攻击间隔(秒)"}
  }
}
