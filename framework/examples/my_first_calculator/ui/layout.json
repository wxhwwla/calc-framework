{
  "schema_version": "ui-v1",
  "name": "示例伤害计算",
  "sections": [
    {
      "id": "character",
      "type": "inputs",
      "title": "角色属性",
      "columns": 2,
      "variables": ["character.ATK", "character.crit_dmg"]
    },
    {
      "id": "enemy",
      "type": "inputs",
      "title": "敌人属性",
      "columns": 2,
      "variables": ["enemy.DEF"]
    },
    {
      "id": "skill",
      "type": "inputs",
      "title": "技能参数",
      "columns": 2,
      "variables": ["user_input.skill_mult", "user_input.is_crit"]
    },
    {
      "id": "results",
      "type": "outputs",
      "title": "计算结果",
      "columns": 1,
      "outputs": ["总攻击力", "基础伤害", "暴击倍率", "最终伤害"]
    }
  ]
}
